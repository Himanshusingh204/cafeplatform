# https://editorconfig.org
# EditorConfig helps maintain consistent coding styles across editors and IDEs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
# Markdown uses hard line breaks in places; trailing whitespace is meaningful.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{prisma}]
indent_size = 2

[*.{ps1,psm1}]
end_of_line = crlf

[*.{bat,cmd}]
end_of_line = crlf

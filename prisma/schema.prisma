// Spice & Saffron — Indian Café
// Prisma schema. All changes must be migration-based.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum GalleryCategory {
  INTERIOR
  FOOD
  CHEF
  EVENTS
  ATMOSPHERE
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum ActivityAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  FEATURE
  SETTINGS_CHANGED
  MESSAGE_STATUS_CHANGED
  RESERVATION_STATUS_CHANGED
  ORDER_STATUS_CHANGED
  REVIEW_MODERATED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PAY_AT_PICKUP
}

enum DiningMode {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum SubscriptionPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum WebhookStatus {
  SUCCESS
  FAILED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  DIRTY
}

enum TableShape {
  ROUND
  RECTANGLE
  BOOTH
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  SEATED
  CANCELLED
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model Tenant {
  id               String           @id @default(uuid()) @db.Uuid
  slug             String           @unique
  name             String
  customDomain     String?          @unique
  subscriptionPlan SubscriptionPlan @default(PRO)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  admins           Admin[]
  categories       Category[]
  dishes           Dish[]
  orders           Order[]
  reservations     Reservation[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookSubscription[]
  diningTables     DiningTable[]
  waitlistEntries  WaitlistEntry[]
  ingredients      Ingredient[]
  customerUsers    CustomerUser[]

  @@index([slug])
  @@index([customDomain])
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  sessions     Session[]
  activityLogs ActivityLog[]

  @@index([email])
  @@index([tenantId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  adminId   String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @db.Uuid
  name        String
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dishes      Dish[]

  @@index([sortOrder])
  @@index([isActive])
  @@index([tenantId])
}

model Dish {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String?  @db.Uuid
  categoryId       String   @db.Uuid
  name             String
  slug             String   @unique
  shortDescription String
  description      String
  price            Decimal  @db.Decimal(10, 2)
  compareAtPrice   Decimal? @db.Decimal(10, 2)
  image            String?
  isFeatured       Boolean  @default(false)
  isAvailable      Boolean  @default(true)
  isVegetarian     Boolean  @default(false)
  isVegan          Boolean  @default(false)
  isSpicy          Boolean  @default(false)
  containsNuts     Boolean  @default(false)
  preparationTime  Int?
  calories         Int?
  station          String   @default("HOT_KITCHEN")
  sortOrder        Int      @default(0)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modifierGroups   DishModifierGroup[]
  recipeItems      RecipeItem[]

  @@index([categoryId])
  @@index([slug])
  @@index([isAvailable])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([createdAt])
  @@index([tenantId])
}

model GalleryImage {
  id          String          @id @default(uuid()) @db.Uuid
  title       String
  altText     String
  imageUrl    String
  category    GalleryCategory @default(ATMOSPHERE)
  sortOrder   Int             @default(0)
  isPublished Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isPublished])
  @@index([sortOrder])
}

model ContactMessage {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    MessageStatus @default(NEW)
  ipHash    String?
  createdAt DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}

model ActivityLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorId    String?        @db.Uuid
  action     ActivityAction
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime       @default(now())

  actor Admin? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String?           @db.Uuid
  referenceCode   String            @unique
  name            String
  email           String
  phone           String
  guests          Int
  date            DateTime
  timeSlot        String
  specialRequests String?
  status          ReservationStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant          Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([status])
  @@index([referenceCode])
  @@index([tenantId])
}

model Order {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String?       @db.Uuid
  orderNumber         String        @unique
  customerUserId      String?       @db.Uuid
  customerName        String
  customerEmail       String
  customerPhone       String
  pickupTime          String
  diningMode          DiningMode    @default(TAKEAWAY)
  tableNumber         String?
  tip                 Decimal       @default(0) @db.Decimal(10, 2)
  specialInstructions String?
  subtotal            Decimal       @db.Decimal(10, 2)
  tax                 Decimal       @db.Decimal(10, 2)
  discount            Decimal       @default(0) @db.Decimal(10, 2)
  total               Decimal       @db.Decimal(10, 2)
  loyaltyPointsEarned Int           @default(0)
  loyaltyPointsUsed   Int           @default(0)
  paymentStatus       PaymentStatus @default(PENDING)
  orderStatus         OrderStatus   @default(PENDING)
  paymentMethod       String?       @default("PAY_AT_PICKUP")
  gatewayOrderId      String?
  gatewayPaymentId    String?
  gatewaySignature    String?
  couponCode          String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant              Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerUser        CustomerUser? @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  items               OrderItem[]

  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([gatewayOrderId])
  @@index([customerUserId])
  @@index([createdAt])
  @@index([tenantId])
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  dishId      String? @db.Uuid
  dishName    String
  quantity    Int
  price       Decimal @db.Decimal(10, 2)
  station     String  @default("HOT_KITCHEN")
  isCompleted Boolean @default(false)

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  modifiers   OrderItemModifier[]

  @@index([orderId])
  @@index([station])
}

model DishModifierGroup {
  id          String   @id @default(uuid()) @db.Uuid
  dishId      String   @db.Uuid
  name        String
  minSelect   Int      @default(0)
  maxSelect   Int      @default(1)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dish        Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  options     DishModifierOption[]

  @@index([dishId])
  @@index([sortOrder])
}

model DishModifierOption {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @db.Uuid
  name        String
  priceDelta  Decimal  @default(0) @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       DishModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([sortOrder])
}

model OrderItemModifier {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @db.Uuid
  groupName   String
  optionName  String
  priceDelta  Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  customerName String
  rating       Int      @default(5)
  title        String
  comment      String
  dishSlug     String?
  isApproved   Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isApproved])
  @@index([isFeatured])
  @@index([createdAt])
}

model Coupon {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique
  discountPercent Int
  minOrder        Decimal?  @db.Decimal(10, 2)
  isActive        Boolean   @default(true)
  validUntil      DateTime?
  createdAt       DateTime  @default(now())

  @@index([code])
  @@index([isActive])
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  keyPrefix   String
  keyHash     String    @unique
  scopes      String[]  @default([])
  ipAllowlist String[]  @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyHash])
}

model WebhookSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  url       String
  secret    String
  events    String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
}

model WebhookDelivery {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String        @db.Uuid
  event          String
  payload        Json
  responseCode   Int?
  status         WebhookStatus @default(SUCCESS)
  attempts       Int           @default(1)
  error          String?
  createdAt      DateTime      @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([createdAt])
}

model Ingredient {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String?      @db.Uuid
  name         String
  unit         String       @default("pcs")
  currentStock Decimal      @default(0) @db.Decimal(10, 2)
  parLevel     Decimal      @default(10) @db.Decimal(10, 2)
  costPerUnit  Decimal?     @db.Decimal(10, 2)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipeItems  RecipeItem[]

  @@index([tenantId])
  @@index([name])
}

model RecipeItem {
  id               String     @id @default(uuid()) @db.Uuid
  dishId           String     @db.Uuid
  ingredientId     String     @db.Uuid
  quantityRequired Decimal    @db.Decimal(10, 2)
  createdAt        DateTime   @default(now())

  dish             Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([dishId, ingredientId])
  @@index([dishId])
  @@index([ingredientId])
}

model DiningTable {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String?     @db.Uuid
  tableNumber    String
  capacity       Int         @default(4)
  status         TableStatus @default(AVAILABLE)
  shape          TableShape  @default(RECTANGLE)
  posX           Int         @default(100)
  posY           Int         @default(100)
  width          Int         @default(120)
  height         Int         @default(80)
  section        String      @default("Main Dining")
  currentOrderId String?     @db.Uuid
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant         Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tableNumber])
  @@index([status])
}

model WaitlistEntry {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String?        @db.Uuid
  customerName         String
  customerPhone        String
  partySize            Int
  specialNotes         String?
  status               WaitlistStatus @default(WAITING)
  estimatedWaitMinutes Int            @default(15)
  notifiedAt           DateTime?
  seatedAt             DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenant               Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model CustomerUser {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String?         @db.Uuid
  name          String
  email         String          @unique
  phone         String?
  loyaltyPoints Int             @default(0)
  loyaltyTier   LoyaltyTier     @default(BRONZE)
  lifetimeSpend Decimal         @default(0) @db.Decimal(10, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders        Order[]
  ledgerEntries LoyaltyLedger[]

  @@index([tenantId])
  @@index([email])
  @@index([loyaltyTier])
}

model LoyaltyLedger {
  id          String       @id @default(uuid()) @db.Uuid
  customerId  String       @db.Uuid
  orderId     String?      @db.Uuid
  pointsDelta Int
  reason      String
  createdAt   DateTime     @default(now())

  customer    CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([orderId])
  @@index([createdAt])
}
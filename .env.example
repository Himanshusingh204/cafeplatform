# Server-only environment variables. Never prefix with NEXT_PUBLIC_.
# Copy to .env.local for local development (never commit real secrets).

# PostgreSQL connection string (Prisma + runtime)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/indian_cafe?schema=public"

# Secret used to sign/encrypt sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical site URL (used for metadata, sitemap, redirects)
APP_URL="http://localhost:3000"

# Extra browser origins allowed to submit mutations (CSRF origin check).
# Comma-separated absolute origins, e.g. "https://www.example.com,https://staging.example.com".
# Leave empty by default; wildcard/shared preview domains (e.g. *.vercel.app) are never trusted.
ALLOWED_ORIGINS=""

# Decoupled Standalone Backend API (runs on port 4000)
API_PORT="4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Optional: transactional email (Resend) for contact notifications.
# Both EMAIL_API_KEY and CONTACT_NOTIFY_EMAIL must be set to enable sending.
# EMAIL_FROM_ADDRESS is optional; defaults to the Resend test sender until your domain is verified.
EMAIL_API_KEY=""
CONTACT_NOTIFY_EMAIL=""
EMAIL_FROM_ADDRESS=""

# Image storage (required in production for admin image uploads).
# Works with any S3-compatible object store: AWS S3, Cloudflare R2, MinIO, B2.
# STORAGE_DRIVER: "s3" (used automatically when a bucket is set) or "local".
# In local development leave these blank: uploads then use public/uploads.
STORAGE_DRIVER=""
STORAGE_BUCKET=""
STORAGE_REGION=""            # e.g. ap-south-1 for AWS; "auto" for Cloudflare R2
STORAGE_ENDPOINT=""          # e.g. https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL=""        # public base URL objects are served from, no trailing slash
STORAGE_FORCE_PATH_STYLE=""  # "true" for MinIO; blank for AWS S3 and R2

# Optional: FinTech & Payment Gateways (Razorpay & Stripe)
# For Razorpay (Standard in India: UPI, Cards, Netbanking):
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# For Stripe (Global Credit/Debit Cards):
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Shared HMAC-SHA256 secret for the partner webhook ingress
# (POST /api/v1/webhooks/ingress). The route fails closed when this is blank.
PARTNER_WEBHOOK_SECRET=""

# Optional: Upstash Redis for distributed rate limiting (recommended for production)
# Without this, rate limiting falls back to in-memory (per-instance only)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# PRODUCTION BOOT REQUIREMENT: the app refuses to start (instrumentation.ts / server/api.ts)
# unless DATABASE_URL, AUTH_SECRET, APP_URL are set AND either the Upstash pair above is set
# or you explicitly waive shared state with ALLOW_IN_MEMORY_STATE=true. The waiver is only
# safe for a single long-lived instance: rate limits, idempotency and realtime are per-process.
ALLOW_IN_MEMORY_STATE=""

# Database pool bounds (all optional; defaults: max 5 on Vercel / 10 elsewhere).
# DB_POOL_MAX, DB_POOL_IDLE_TIMEOUT_MS, DB_POOL_CONNECTION_TIMEOUT_MS, DB_STATEMENT_TIMEOUT_MS, DB_POOL_MAX_USES
DB_POOL_MAX=""

# PRODUCTION BOOT REQUIREMENT: the app refuses to start (instrumentation.ts / server/api.ts)
# unless DATABASE_URL, AUTH_SECRET and APP_URL are set AND either the Upstash pair above is set
# or you explicitly waive shared state with ALLOW_IN_MEMORY_STATE="true". The waiver is only
# safe for a single long-lived instance: rate limits, idempotency and realtime are per-process.
ALLOW_IN_MEMORY_STATE=""

# Database pool bounds (all optional). Defaults: max 5 on Vercel, 10 elsewhere.
# Also: DB_POOL_IDLE_TIMEOUT_MS, DB_POOL_CONNECTION_TIMEOUT_MS, DB_STATEMENT_TIMEOUT_MS, DB_POOL_MAX_USES
DB_POOL_MAX=""

# Optional: pricing. TAX_RATE_PERCENT is the restaurant GST applied to the
# taxable amount (subtotal minus discounts), as a percentage — not a fraction.
# Defaults to 5. A per-tenant rate arrives with Tenant.taxRatePercent in Phase 2.
TAX_RATE_PERCENT=""

# Admin bootstrap (used by scripts/create-admin.mjs only)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
ADMIN_ROLE=""

# Seed configuration (used by prisma db seed)
# Set to "true" to include demo dishes, categories, and gallery images
SEED_DEMO_DATA="false"

# Cafe settings (used by prisma db seed, optional overrides)
CAFE_NAME=""
CAFE_TAGLINE=""
CAFE_PHONE=""
CAFE_EMAIL=""
CAFE_ADDRESS=""
CAFE_MAPS_LINK=""
CAFE_OPENING_HOURS=""
CAFE_INSTAGRAM=""
CAFE_FACEBOOK=""
CAFE_WHATSAPP=""
CAFE_RESERVATION_LINK=""
# Single-tenant installs: allow requests without an explicit tenant slug to use the
# default tenant in production. Without this, order creation throws in production.
ALLOW_DEFAULT_TENANT="true"

# Bearer secret for /api/cron/* (Vercel Cron sends it automatically). Required in production.
CRON_SECRET=""

# Bearer token for GET /api/metrics (Prometheus text). Endpoint returns 404 when unset.
METRICS_TOKEN=""

# Number of reverse proxies in front of the Express service (0 = none). Used for the API-key IP allowlist.
TRUST_PROXY_HOPS=0

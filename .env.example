# Server-only environment variables. Never prefix with NEXT_PUBLIC_.
# Copy to .env.local for local development (never commit real secrets).

# PostgreSQL connection string (Prisma + runtime)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/indian_cafe?schema=public"

# Secret used to sign/encrypt sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical site URL (used for metadata, sitemap, redirects)
APP_URL="http://localhost:3000"

# Optional: transactional email (Resend) for contact notifications.
# Both EMAIL_API_KEY and CONTACT_NOTIFY_EMAIL must be set to enable sending.
# EMAIL_FROM_ADDRESS is optional; defaults to the Resend test sender until your domain is verified.
EMAIL_API_KEY=""
CONTACT_NOTIFY_EMAIL=""
EMAIL_FROM_ADDRESS=""

# Optional: Vercel Blob / S3-compatible image storage
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Optional: Upstash Redis for distributed rate limiting (recommended for production)
# Without this, rate limiting falls back to in-memory (per-instance only)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Admin bootstrap (used by scripts/create-admin.mjs only)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
ADMIN_ROLE=""

# Seed configuration (used by prisma db seed)
# Set to "true" to include demo dishes, categories, and gallery images
SEED_DEMO_DATA="false"

# Cafe settings (used by prisma db seed, optional overrides)
CAFE_NAME=""
CAFE_TAGLINE=""
CAFE_PHONE=""
CAFE_EMAIL=""
CAFE_ADDRESS=""
CAFE_MAPS_LINK=""
CAFE_OPENING_HOURS=""
CAFE_INSTAGRAM=""
CAFE_FACEBOOK=""
CAFE_WHATSAPP=""
CAFE_RESERVATION_LINK=""
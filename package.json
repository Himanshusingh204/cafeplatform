{
  "name": "spice-and-saffron",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant Indian café and restaurant commerce + operations platform: storefront, ordering, kitchen display, reservations, loyalty and admin CMS.",
  "author": "Himanshu <himanshuyt21361@gmail.com> (https://github.com/Himanshusingh204)",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:server": "tsx server/api.ts",
    "dev:all": "concurrently -n \"FRONTEND,BACKEND\" -c \"cyan,magenta\" \"npm run dev\" \"npm run dev:server\"",
    "start:server": "tsx server/api.ts",
    "build": "next build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "vitest run tests/parity",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "next build && playwright test",
    "create-admin": "node scripts/create-admin.mjs",
    "verify:prod": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "10.0.6",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
